{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roles.local/schemas/role.schema.json",
  "title": ".roles role frontmatter",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tier": {
      "type": "string",
      "minLength": 1
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "version": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    }
  }
}
